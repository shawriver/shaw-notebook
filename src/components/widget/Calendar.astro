---
import WidgetLayout from "./WidgetLayout.astro";

const nowParts = new Intl.DateTimeFormat("en-US", {
	timeZone: "Asia/Shanghai",
	year: "numeric",
	month: "numeric",
	day: "numeric",
}).formatToParts(new Date());
const getPart = (type: string) => Number(nowParts.find((part) => part.type === type)?.value);
const year = getPart("year");
const month = getPart("month") - 1;
const todayDate = getPart("day");
const currentDate = new Date(Date.UTC(year, month, todayDate));
const monthName = new Intl.DateTimeFormat("zh-CN", { month: "long", timeZone: "Asia/Shanghai" }).format(currentDate);
const firstDay = new Date(Date.UTC(year, month, 1)).getUTCDay();
const daysInMonth = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
const cells = Array.from({ length: firstDay + daysInMonth }, (_, index) =>
	index < firstDay ? null : index - firstDay + 1,
);
const weekDays = ["日", "一", "二", "三", "四", "五", "六"];
---

<WidgetLayout name="日历" id="calendar" class="calendar-widget">
	<div class="flex items-center justify-between mb-3 px-1 calendar-heading">
		<span class="text-sm text-50 calendar-year">{year}</span>
		<div class="flex items-baseline gap-2">
			<span class="font-bold text-90 calendar-month">{monthName}</span>
			<span class="text-xs text-50 calendar-current">今天 {todayDate} 日</span>
		</div>
	</div>
	<div class="grid grid-cols-7 gap-1 text-center text-xs text-50 mb-2">
		{weekDays.map((day) => <span>{day}</span>)}
	</div>
	<div class="grid grid-cols-7 gap-1 text-center text-sm calendar-days">
		{cells.map((day) => day === null ? <span class="h-8"></span> :
			<span class:list={["h-8 flex items-center justify-center rounded-lg", { "calendar-today": day === todayDate }]}>{day}</span>
		)}
	</div>
</WidgetLayout>

<script>
	const calendarTimeZone = "Asia/Shanghai";

	function getCalendarDate() {
		const parts = new Intl.DateTimeFormat("en-US", {
			timeZone: calendarTimeZone,
			year: "numeric",
			month: "numeric",
			day: "numeric",
		}).formatToParts(new Date());
		const value = (type: string) => Number(parts.find((part) => part.type === type)?.value);
		return { year: value("year"), month: value("month") - 1, day: value("day") };
	}

	function renderCalendar() {
		const calendar = document.querySelector("#calendar");
		if (!calendar) return;
		const date = getCalendarDate();
		const firstDay = new Date(Date.UTC(date.year, date.month, 1)).getUTCDay();
		const daysInMonth = new Date(Date.UTC(date.year, date.month + 1, 0)).getUTCDate();
		const monthName = new Intl.DateTimeFormat("zh-CN", { month: "long", timeZone: calendarTimeZone })
			.format(new Date(Date.UTC(date.year, date.month, 1)));
		const yearElement = calendar.querySelector(".calendar-year");
		const monthElement = calendar.querySelector(".calendar-month");
		const currentElement = calendar.querySelector(".calendar-current");
		const daysElement = calendar.querySelector(".calendar-days");
		if (!yearElement || !monthElement || !currentElement || !daysElement) return;
		yearElement.textContent = String(date.year);
		monthElement.textContent = monthName;
		currentElement.textContent = `今天 ${date.day} 日`;
		daysElement.replaceChildren();
		for (let index = 0; index < firstDay + daysInMonth; index += 1) {
			const cell = document.createElement("span");
			cell.className = "h-8 flex items-center justify-center rounded-lg";
			if (index < firstDay) {
				cell.setAttribute("aria-hidden", "true");
			} else {
				const day = index - firstDay + 1;
				cell.textContent = String(day);
				if (day === date.day) cell.classList.add("calendar-today");
			}
			daysElement.appendChild(cell);
		}
	}

	renderCalendar();
	setInterval(renderCalendar, 60_000);
</script>

<style>
	.calendar-today {
		color: var(--primary);
		box-shadow: inset 0 0 0 1.5px var(--primary);
		font-weight: 700;
	}

	.calendar-days {
		color: var(--deep-text);
	}

	:global(.dark) .calendar-days {
		color: rgba(255, 255, 255, 0.88);
	}
</style>
